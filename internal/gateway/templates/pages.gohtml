{{define "head"}}<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{.Title}}</title>
<style>
:root{color-scheme:light dark;--bg:#f4f5f7;--card:#fff;--fg:#1c1e21;--muted:#5f6670;--line:#dde0e5;--accent:#2563eb;--accent-h:#1d4ed8;--accent-a:#1e40af;--on-accent:#fff;--track:#e3e6ea;--shadow:0 1px 2px rgba(16,24,40,.06),0 8px 24px rgba(16,24,40,.08)}
@media(prefers-color-scheme:dark){:root{--bg:#0f1115;--card:#181b21;--fg:#eceef1;--muted:#9aa2ad;--line:#2a2f38;--accent:#3b82f6;--accent-h:#5b97f8;--accent-a:#2f6fdc;--on-accent:#fff;--track:#2a2f38;--shadow:0 1px 2px rgba(0,0,0,.4),0 8px 24px rgba(0,0,0,.35)}}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:1rem;background:var(--bg);color:var(--fg);font:16px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;-webkit-font-smoothing:antialiased}
main{width:100%;max-width:26rem;padding:2.25rem 2rem;text-align:center;background:var(--card);border:1px solid var(--line);border-radius:1rem;box-shadow:var(--shadow)}
h1{font-size:1.375rem;line-height:1.3;font-weight:650;margin:0 0 .5rem;letter-spacing:-.01em}
p{margin:.5rem 0;overflow-wrap:anywhere}
.muted{color:var(--muted);font-size:.9rem}
.lead{color:var(--muted)}
time{white-space:nowrap}
.bar{height:.5rem;border-radius:.25rem;background:var(--track);overflow:hidden;margin:1.5rem 0 1rem}
.bar>div{height:100%;width:0;background:var(--accent);border-radius:.25rem;transition:width .4s}
.btn{display:inline-block;margin-top:1.5rem;padding:.7rem 2rem;min-width:9rem;font:inherit;font-weight:600;color:var(--on-accent);background:var(--accent);border:0;border-radius:.6rem;cursor:pointer;transition:background .15s,transform .05s}
.btn:hover{background:var(--accent-h)}
.btn:active{background:var(--accent-a);transform:translateY(1px)}
.btn:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
.btn.alt{color:var(--fg);background:transparent;border:1px solid var(--line)}
.btn.alt:hover{border-color:var(--accent)}
.btns{display:flex;flex-wrap:wrap;gap:0 .75rem;justify-content:center}
.btns form{margin:0}
.btn:disabled{opacity:.6;cursor:progress;transform:none}
@media(max-width:480px){main{padding:1.75rem 1.25rem}.btn{display:block;width:100%}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
.apps{display:grid;grid-template-columns:repeat(auto-fill,minmax(7.5rem,1fr));gap:.75rem;margin:1.5rem 0 0;padding:0;list-style:none}
.app{position:relative;display:flex;flex-direction:column;align-items:center;gap:.5rem;padding:1rem .5rem;height:100%;color:inherit;text-decoration:none;border:1px solid var(--line);border-radius:.75rem}
.app:hover{border-color:var(--accent)}
.app:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.app img,.app .ph{width:3rem;height:3rem;object-fit:contain}
.app .ph{display:flex;align-items:center;justify-content:center;font-weight:650;font-size:1.25rem;color:var(--on-accent);background:var(--accent);border-radius:.75rem}
.app span.n{font-size:.9rem;line-height:1.3;overflow-wrap:anywhere}
.badge{position:absolute;top:.4rem;right:.4rem;padding:0 .4rem;font-size:.7rem;line-height:1.3;color:var(--on-accent);background:var(--accent);border-radius:.6rem}
main.wide{max-width:56rem}
</style></head><body><main{{if .Wide}} class="wide"{{end}}>{{end}}
{{define "foot"}}</main></body></html>{{end}}

{{define "error"}}{{template "head" .}}
<h1>{{.Title}}</h1>
<p class="lead">{{.Message}}</p>
{{if .Back}}<p><a href="{{.Back}}">Back to apps</a></p>{{end}}
{{template "foot" .}}{{end}}

{{define "apps"}}{{template "head" .}}
<h1>Apps</h1>
{{if .Apps}}<ul class="apps">
{{range .Apps}}<li><a class="app" href="{{.Href}}" target="webtop-app-{{.ID}}">{{if .IconURL}}<img src="{{.IconURL}}" alt="" width="48" height="48" loading="lazy">{{else}}<span class="ph" aria-hidden="true">{{.Initial}}</span>{{end}}<span class="n">{{.Name}}</span>{{if .Running}}<span class="badge">running</span>{{end}}</a></li>
{{end}}</ul>{{else}}<p class="lead">This desktop has no applications.</p>{{end}}
{{template "foot" .}}{{end}}

{{define "boot"}}{{template "head" .}}
<h1>Starting your desktop</h1>
<p id="stage" class="lead">{{.Stage}}</p>
<div class="bar"><div id="bar" style="width:{{.Progress}}%"></div></div>
<p id="pull" class="muted"></p>
<p id="restore" class="muted"{{if not .Restore}} hidden{{end}}>Your software is being restored in the background after an update.</p>
<p id="msg" class="muted">{{.Message}}</p>
<noscript><p class="muted">Enable JavaScript or reload this page to follow the progress.</p></noscript>
<script>
(function(){
  var stage=document.getElementById("stage"),bar=document.getElementById("bar"),msg=document.getElementById("msg");
  var pullEl=document.getElementById("pull"),pull=null,pullAt=0,pullTimer=null;
  function dur(s){var m=Math.floor(s/60);return m>0?m+"m "+(s%60)+"s":s+"s"}
  function size(b){return b>=1e9?(b/1e9).toFixed(1)+" GB":Math.round(b/1e6)+" MB"}
  // Elapsed ticks from when the server said it, not from the browser's idea of the start time.
  function showPull(){
    var secs=pull.elapsedSeconds+Math.round((Date.now()-pullAt)/1000);
    var t=[];
    if(pull.sizeBytes){t.push(size(pull.sizeBytes))}
    t.push(dur(secs)+" elapsed");
    if(pull.lastDurationSeconds){
      t.push("about "+Math.min(95,Math.floor(secs*100/pull.lastDurationSeconds))+"% (estimate from an earlier download)");
    }
    pullEl.textContent=t.join(" \u00b7 ");
  }
  function setPull(p){
    pull=p;pullAt=Date.now();
    if(!p){pullEl.textContent="";if(pullTimer){clearInterval(pullTimer);pullTimer=null}return}
    showPull();
    if(!pullTimer){pullTimer=setInterval(showPull,1000)}
  }
  var restoreEl=document.getElementById("restore");
  var idleTimer=null,errTimer=null,sawOther=false;
  var es=new EventSource({{.EventsURL}});
  es.addEventListener("status",function(e){
    var s=JSON.parse(e.data);
    if(s.stage){stage.textContent=s.stage}
    bar.style.width=(s.bootProgress||0)+"%";
    msg.textContent=s.message||"";
    setPull(s.pull||null);
    restoreEl.hidden=!s.softwareRestore;
    // Stopped or stopping while this page is open: reload to get the right page.
    if(s.phase==="Off"||s.phase==="Stopping"){
      if(!idleTimer){idleTimer=setTimeout(function(){location.reload()},30000)}
    }else if(idleTimer){clearTimeout(idleTimer);idleTimer=null}
    // Error: reload to get the error page. Right after Restart the status still shows the old
    // error, so a page that opened on one waits before it looks again.
    if(s.phase==="Error"){
      if(!errTimer){errTimer=setTimeout(function(){location.reload()},sawOther?1500:30000)}
    }else{
      sawOther=true;
      if(errTimer){clearTimeout(errTimer);errTimer=null}
    }
  });
  es.addEventListener("ready",function(){es.close();location.reload()});
})();
</script>
{{template "foot" .}}{{end}}

{{define "off"}}{{template "head" .}}
<h1>Your desktop is off</h1>
<p class="lead">Start it to pick up where you left off.</p>
<p class="muted">{{.Reason}}{{with .StoppedAt}} <time datetime="{{.Format "2006-01-02T15:04:05Z07:00"}}">{{.Format "2006-01-02 15:04 UTC"}}</time>{{end}}</p>
<form method="post" action="{{.StartURL}}" id="start">
<input type="hidden" name="csrf" value="{{.CSRF}}">
{{with .App}}<input type="hidden" name="app" value="{{.}}">
{{end}}<button class="btn" type="submit">Start desktop</button>
</form>
<script>
(function(){
  var f=document.getElementById("start"),b=f.querySelector("button");
  f.addEventListener("submit",function(e){
    if(b.disabled){e.preventDefault();return}
    // Disable after the submit has been collected: a disabled button is not a form field, and the CSRF field is separate.
    setTimeout(function(){b.disabled=true;b.textContent="Starting…"},0);
  });
  // pageshow: coming back via the back button must not leave the button stuck.
  addEventListener("pageshow",function(e){if(e.persisted){b.disabled=false;b.textContent="Start desktop"}});
  var t=document.querySelector("time");
  if(t){var d=new Date(t.getAttribute("datetime"));if(!isNaN(d)){t.textContent=d.toLocaleString([], {dateStyle:"medium",timeStyle:"short"})}}
})();
</script>
{{template "foot" .}}{{end}}

{{define "asleep"}}{{template "head" .}}
<h1>Your desktop is asleep</h1>
<p class="lead">Wake it to pick up where you left off.</p>
<form method="post" action="{{.WakeURL}}" id="wake">
<input type="hidden" name="csrf" value="{{.CSRF}}">
{{with .App}}<input type="hidden" name="app" value="{{.}}">
{{end}}<button class="btn" type="submit">Wake desktop</button>
</form>
<script>
(function(){
  var f=document.getElementById("wake"),b=f.querySelector("button");
  f.addEventListener("submit",function(e){
    if(b.disabled){e.preventDefault();return}
    setTimeout(function(){b.disabled=true;b.textContent="Waking…"},0);
  });
  addEventListener("pageshow",function(e){if(e.persisted){b.disabled=false;b.textContent="Wake desktop"}});
})();
</script>
{{template "foot" .}}{{end}}

{{define "failed"}}{{template "head" .}}
<h1>{{.Title}}</h1>
<p class="lead">{{.Reason}}</p>
{{if .CanRecover}}<p class="muted">Restarting applies any pending update. Stopping keeps your files.</p>
<div class="btns">
<form method="post" action="{{.RestartURL}}" class="act" data-busy="Restarting…">
<input type="hidden" name="csrf" value="{{.CSRF}}">
<button class="btn" type="submit">Restart desktop</button>
</form>
<form method="post" action="{{.StopURL}}" class="act" data-busy="Stopping…">
<input type="hidden" name="csrf" value="{{.CSRF}}">
<button class="btn alt" type="submit">Stop desktop</button>
</form>
</div>{{end}}
<script>
(function(){
  var fs=document.querySelectorAll("form.act");
  function all(d){for(var i=0;i<fs.length;i++){fs[i].querySelector("button").disabled=d}}
  Array.prototype.forEach.call(fs,function(f){
    var b=f.querySelector("button"),label=b.textContent;
    f.addEventListener("submit",function(e){
      if(b.disabled){e.preventDefault();return}
      // Disable after the submit has been collected: a disabled button is not a form field, and the CSRF field is separate.
      setTimeout(function(){all(true);b.textContent=f.getAttribute("data-busy")},0);
    });
    addEventListener("pageshow",function(e){if(e.persisted){all(false);b.textContent=label}});
  });
  // The desktop recovered or was stopped meanwhile: show the right page.
  var es=new EventSource({{.EventsURL}});
  es.addEventListener("status",function(e){if(JSON.parse(e.data).phase!=="Error"){es.close();location.reload()}});
  es.addEventListener("ready",function(){es.close();location.reload()});
})();
</script>
{{template "foot" .}}{{end}}
