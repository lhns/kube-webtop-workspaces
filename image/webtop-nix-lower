#!@busybox@/bin/sh
# The store overlay's side of an image update (ADR 0008), run by webtop-init before the overlay is
# mounted. When the image's store differs from the one the upper was used with, webtop-nix-partial
# invalidates what the new store breaks; if it cannot, the overlay is reset as a whole: upper, work
# and DB move to trash-<epoch>, which webtop-nix-restore.service copies the users' paths back from.
# Either way each user's Nix profile manifest is recorded first (the reinstall's fallback).
# Env (tests): STAMP_FILE, WEBTOP_PERSIST_ROOT, PARTIAL.
set -u
STAMP_FILE=${STAMP_FILE:-/webtop-image-stamp}
P=${WEBTOP_PERSIST_ROOT:-/persist}
N=$P/nix
PARTIAL=${PARTIAL:-$(dirname "$0")/webtop-nix-partial}
export N

log() { echo "webtop-init: $*"; }

# Store path name a profile symlink chain ends in. Resolved by hand: the target is usually an
# upper-only path, which does not exist before the overlay is mounted.
profile_target() {
  l=$1
  for _ in 1 2 3 4; do
    [ -L "$l" ] || break
    t=$(readlink "$l")
    case "$t" in
      /nix/store/*) echo "${t#/nix/store/}" | cut -d/ -f1; return 0 ;;
      /*) l=$t ;;
      *) l=$(dirname "$l")/$t ;;
    esac
  done
  return 1
}

record_manifests() {
  r=$N/reinstall
  mkdir -p "$r" || return 1
  for home in "$P"/home/*; do
    [ -d "$home/.local/state/nix/profiles" ] || continue
    u=$(basename "$home")
    if sp=$(profile_target "$home/.local/state/nix/profiles/profile"); then
      for d in "$N/upper" /.lower/nix/store; do
        if [ -f "$d/$sp/manifest.json" ]; then
          cp "$d/$sp/manifest.json" "$r/$u.manifest.json" && log "recorded the nix profile of $u ($sp)"
          break
        fi
      done
    fi
  done
}

full_reset() {
  t=$N/trash-$(date +%s)
  mkdir -p "$t" || return 1
  for d in upper work var; do
    if [ -e "$N/$d" ]; then mv "$N/$d" "$t/$d" || return 1; fi
  done
  # Upper entries named like paths of the old image's store are copy-up leftovers or whiteouts,
  # never whole store objects: kept out of the restore's way so it substitutes those paths
  # instead of copying a partial tree.
  if [ -f "$N/lower-paths" ] && [ -d "$t/upper" ]; then
    mkdir -p "$t/junk" || return 1
    ls -A "$t/upper" | while IFS= read -r b; do
      if grep -qxF "/nix/store/$b" "$N/lower-paths"; then mv "$t/upper/$b" "$t/junk/$b" || exit 1; fi
    done || return 1
  fi
  # The users' profile links dangle until the restore; their GC roots come back at once so the
  # restored paths are never collectable.
  mkdir -p "$N/var" || return 1
  for d in gcroots profiles; do
    if [ -d "$t/var/$d" ]; then cp -a "$t/var/$d" "$N/var/$d" || return 1; fi
  done
  touch "$N/reinstall/pending" "$N/reinstall/restore"
}

save_lower_paths() { "$PARTIAL" --write-lower-paths || log "could not save the image's store path list: the next update resets the store overlay"; }

write_stamp() {
  sync # everything before (renames, DB commits, lower-paths) is on disk before the stamp says so
  echo "$new" > "$N/lower-stamp.tmp" && mv "$N/lower-stamp.tmp" "$N/lower-stamp"
}

new=$(cat "$STAMP_FILE") || exit 1
old=$(cat "$N/lower-stamp" 2>/dev/null)
if [ "$old" = "$new" ]; then
  # Volumes from before the list was kept: the upper has been used with exactly this store.
  [ -f "$N/lower-paths" ] || save_lower_paths
  exit 0
fi
if [ -z "$old" ] && [ ! -d "$N/upper" ]; then
  log "first boot on this volume"
  mkdir -p "$N" || exit 1
  save_lower_paths
  write_stamp
  exit
fi

log "image store changed (${old:-no stamp} -> $new)"
record_manifests || exit 1
"$PARTIAL"
rc=$?
case $rc in
  0) log "store overlay kept: only what the new image breaks was invalidated" ;;
  99) exit 99 ;; # test hook: a simulated kill, nothing else runs
  *)
    log "PARTIAL INVALIDATION FAILED (exit $rc, reason above): resetting the store overlay"
    full_reset || exit 1
    save_lower_paths
    ;;
esac
write_stamp
