#!@busybox@/bin/sh
# After an image update, invalidates in the store overlay exactly what the new lower store breaks
# (ADR 0008). Called by webtop-nix-lower before the overlay is mounted; busybox and the image's
# nix-store only. Every upper-DB row whose closure holds a path the new image dropped or changed is
# invalidated with Nix's own GC (the upper opened as a plain local store), and every upper entry that
# would merge with or hide a new lower path is moved to a trash webtop-nix-restore reads.
#   webtop-nix-partial                      invalidate
#   webtop-nix-partial --write-lower-paths  only save the image's store path list
# Exit 0: the upper is consistent with the new lower. Any other exit: the pre-run state has been
# restored (or nothing was changed); the caller resets the overlay.
# Test hooks: WEBTOP_TEST_CRASH_AT=<step> exits 99 without cleanup (a kill), WEBTOP_TEST_FAIL_AT=<step>
# exits 4 through the failure path.
set -eu
set -o pipefail
N=${N:-/persist/nix}
LOWER=${LOWER:-/.lower}
NIXSTORE_BIN=${NIXSTORE_BIN:-@nixStore@}
U=$N/upper
UP="local?real=$U&state=$N/var"
LO="local?root=$LOWER&read-only=true"
# Scratch on tmpfs (webtop-init mounts /run first): nothing in it must survive a crash, and a
# full volume must not fail the procedure.
W=${WEBTOP_NIX_PARTIAL_WORK:-/run/webtop/nix-partial}
# Before activation there is no passwd entry and maybe no HOME: Nix's getHome() would throw.
# (Never name a variable NIX_STORE here: Nix reads it as the store directory.)
export HOME=$W/home XDG_CONFIG_HOME=$W/config XDG_CACHE_HOME=$W/cache XDG_STATE_HOME=$W/state
export NIX_CONFIG="experimental-features = read-only-local-store
build-users-group =
keep-outputs = false
keep-derivations = false"

log() { echo "webtop-nix-partial: [$(cut -d" " -f1 /proc/uptime)] $*" >&2; }
hook() {
  if [ "${WEBTOP_TEST_CRASH_AT:-}" = "$1" ]; then log "test crash at $1"; exit 99; fi
  if [ "${WEBTOP_TEST_FAIL_AT:-}" = "$1" ]; then log "test failure at $1"; exit 4; fi
}
nixstore() { "$NIXSTORE_BIN" "$@"; }

# Record heads of a --dump-db stream (path, hash, size, deriver, n, n refs).
heads() { awk 'BEGIN{st=0} { if (st==0) {print; st=1} else if (st<4) st++; else if (st==4) { n=$0+0; st = n ? 5 : 0 } else if (--n == 0) st=0 }'; }

write_lower_paths() {
  mkdir -p "$W"
  nixstore --store "$LO" --dump-db | heads | sort > "$N/lower-paths.tmp"
  # Everything this run changed is on disk before the commit point (and the caller syncs again
  # before writing the stamp).
  sync
  mv "$N/lower-paths.tmp" "$N/lower-paths"
}

# Put back everything a run moved, and the DB it snapshotted: the exact pre-run state.
rollback() {
  if [ -f "$N/partial.trash" ]; then
    mkdir -p "$W"
    T=$(cat "$N/partial.trash")
    log "restoring the pre-run state from $T"
    for d in upper junk; do
      [ -d "$T/$d" ] || continue
      ls -A "$T/$d" > "$W/rollback.ls"
      while IFS= read -r b; do
        # Opening the upper as a store re-creates an empty .links; the original comes back.
        if [ "$b" = .links ] && [ -d "$U/.links" ]; then rm -rf "$U/.links"; fi
        if [ -e "$U/$b" ] || [ -L "$U/$b" ]; then log "rollback: $U/$b exists"; return 1; fi
        mv "$T/$d/$b" "$U/$b"
      done < "$W/rollback.ls"
    done
    if [ -d "$T/var/db" ]; then
      rm -f "$N/var/db/db.sqlite-wal" "$N/var/db/db.sqlite-shm"
      cp -a "$T/var/db/." "$N/var/db/"
    fi
    rm -rf "$T"
  fi
  # What the run created itself: the empty .links a store open makes, the markers.
  if [ -f "$N/partial.nolinks" ] && [ -d "$U/.links" ]; then rm -rf "$U/.links"; fi
  if [ -f "$N/partial.created" ]; then
    while IFS= read -r f; do rm -rf "${N:?}/$f"; done < "$N/partial.created"
  fi
  sync
  rm -f "$N/partial.trash" "$N/partial.attempts" "$N/partial.nolinks" "$N/partial.created"
}

if [ "${1:-}" = --write-lower-paths ]; then write_lower_paths; exit 0; fi

# No upper store yet: nothing to invalidate.
if [ ! -f "$N/var/db/db.sqlite" ]; then
  log "no upper store: nothing to do"
  write_lower_paths
  exit 0
fi

a=$(cat "$N/partial.attempts" 2>/dev/null || echo 0)
if [ "$a" -ge 2 ]; then
  log "interrupted $a times: giving up"
  rollback
  exit 3
fi
echo $((a + 1)) > "$N/partial.attempts.tmp" && mv "$N/partial.attempts.tmp" "$N/partial.attempts"

# From here on, any failure restores the pre-run state; a kill leaves it to the rerun.
trap 'rc=$?; if [ "$rc" != 0 ] && [ "$rc" != 99 ]; then rollback || log "ROLLBACK FAILED"; fi; exit $rc' EXIT

[ -f "$N/lower-paths" ] || { log "no saved lower path list"; exit 3; }
[ -d "$U" ] || { log "no upper layer"; exit 3; }
[ "$(cat "$N/var/db/schema" 2>/dev/null)" = 10 ] || { log "unexpected DB schema"; exit 3; }

rm -rf "$W"; mkdir -p "$W"
log "start (attempt $((a + 1)))"
# Opening the upper as a store creates upper/.links; remember whether it was there before.
if [ "$a" = 0 ]; then
  rm -f "$N/partial.nolinks" "$N/partial.created"
  [ -e "$U/.links" ] || : > "$N/partial.nolinks"
fi
nixstore --store "$LO" --dump-db > "$W/l1.reg"
nixstore --store "$UP" --dump-db > "$W/rows.reg"
list_upper() {
  ls -A "$U" > "$W/upper.ls"
  find "$U" -mindepth 1 -maxdepth 1 -type c -exec basename {} \; > "$W/whiteouts"
}
list_upper
log "dumped: $(grep -c . "$W/upper.ls") upper entries"

# sig = hash + refs (refs are a sorted set in both dumps).
classify() {
  e=0; if [ -d "$U/.links" ] && [ -z "$(ls -A "$U/.links")" ]; then e=1; fi
  awk -v W="$W" -v mode="$1" -v EMPTYLINKS="$e" '
    function readreg(file, sig, set, refs,   st, p, n, s, line) {
      st = 0
      while ((getline line < file) > 0) {
        if (st == 0) { p = line; set[p] = 1; refs[p] = ""; st = 1 }
        else if (st == 1) { s = line; st = 2 }
        else if (st == 2) { st = 3 }
        else if (st == 3) { st = 4 }
        else if (st == 4) { n = line + 0; if (n == 0) { sig[p] = s; st = 0 } else st = 5 }
        else { s = s " " line; refs[p] = refs[p] " " line; if (--n == 0) { sig[p] = s; st = 0 } }
      }
      close(file)
    }
    function base(p) { sub(/^\/nix\/store\//, "", p); return p }
    # Depth = longest chain of referrers inside Inv. Deleting in increasing depth removes every
    # path after all its referrers, so any in-order batch split is referrer-closed for the GC.
    function order(   r, n, i, j, k, ne, changed) {
      ne = 0
      for (r in INVP) { n = split(rrefs[r], R, " "); for (i = 1; i <= n; i++)
        if ((R[i] in INVP) && R[i] != r) { EF[ne] = r; ET[ne] = R[i]; ne++ } }
      for (r in INVP) D[r] = 0
      do { changed = 0
        for (k = 0; k < ne; k++) if (D[ET[k]] < D[EF[k]] + 1) { D[ET[k]] = D[EF[k]] + 1; changed = 1 }
      } while (changed)
      for (r in INVP) print D[r], r
    }
    BEGIN {
      while ((getline l < (W "/l0")) > 0) L0[base(l)] = 1
      while ((getline l < (W "/upper.ls")) > 0) UPL[l] = 1
      while ((getline l < (W "/whiteouts")) > 0) WO[l] = 1
      while ((getline l < (W "/inv")) > 0) { INV[base(l)] = 1; INVP[l] = 1 }
      readreg(W "/l1.reg", l1sig, L1, l1refs)
      readreg(W "/rows.reg", rsig, ROWS, rrefs)
      if (mode == "order") { order(); exit }
      for (p in L1) L1b[base(p)] = 1
      for (p in ROWS) {
        b = base(p)
        complete = !(b in L0) && (b in UPL) && !(b in WO)
        if (p in L1) bad = (rsig[p] != l1sig[p])
        else bad = !complete
        if (mode == "seeds" && bad) print p
        if (mode == "check" && bad) print "BAD " p
        if (!(p in L1) && complete) KEEP[b] = 1
      }
      for (b in UPL) {
        if (mode == "check") {
          if (b == ".links") continue   # re-created empty by every store open
          if (b in L1b) print "SHADOW " b
          else if (!(b in KEEP)) print "STRAY " b
        } else if (mode == "moves") {
          # Complete resident objects of invalidated rows go to trash/upper (webtop-nix-restore
          # copies from there); everything else not kept is junk, .links included.
          if ((b in KEEP) && !(b in INV)) continue
          if (b == ".links" && EMPTYLINKS) continue   # an empty one is what any store open leaves
          print ((b in KEEP) ? "upper" : "junk") "\t" b
        }
      }
    }'
}

cp "$N/lower-paths" "$W/l0"
: > "$W/inv"
classify seeds > "$W/seeds"
if [ -s "$W/seeds" ]; then
  xargs "$NIXSTORE_BIN" --store "$UP" -q --referrers-closure < "$W/seeds" | sort -u > "$W/inv"
fi
log "$(wc -l < "$W/seeds") seeds, $(wc -l < "$W/inv") paths to invalidate"
hook after-plan

# One trash dir per run, kept across a crash so the snapshot below stays the pre-run DB.
if [ -f "$N/partial.trash" ]; then T=$(cat "$N/partial.trash"); else
  T=$N/trash-$(date +%s)
  echo "$T" > "$N/partial.trash.tmp" && mv "$N/partial.trash.tmp" "$N/partial.trash"
fi
mkdir -p "$T/junk"
if [ -s "$W/inv" ] && [ ! -d "$T/var" ]; then
  # Snapshot: webtop-nix-restore copies the invalidated roots back after boot; a failure
  # restores it (rollback).
  rm -rf "$T/var.tmp"; mkdir -p "$T/var.tmp/db" "$T/upper"
  cp -a "$N/var/db/schema" "$N/var/db/db.sqlite" "$T/var.tmp/db/"
  for f in db.sqlite-wal db.sqlite-shm; do [ ! -e "$N/var/db/$f" ] || cp -a "$N/var/db/$f" "$T/var.tmp/db/"; done
  for d in gcroots profiles; do [ ! -d "$N/var/$d" ] || cp -a "$N/var/$d" "$T/var.tmp/$d"; done
  mv "$T/var.tmp" "$T/var"
fi
if [ -d "$T/var" ]; then
  # Before any move: a trash with a snapshot always comes with the markers that consume it.
  for f in reinstall reinstall/pending reinstall/restore; do
    [ ! -e "$N/$f" ] || continue
    echo "$f" >> "$N/partial.created"
    if [ "$f" = reinstall ]; then mkdir "$N/$f"; else : > "$N/$f"; fi
  done
fi
hook after-snapshot

# Every move is one rename (an entry is in upper/ or in the trash, never half), batched into
# few processes. Files out first, rows second: a crash in between leaves rows without files,
# which the rerun classifies as seeds again; nothing uses the store before the run completes.
classify moves > "$W/moves"
move() { # <kind> <dest>
  awk -F '\t' -v k="$1" '$1 == k { print $2 }' "$W/moves" | tr '\n' '\0' |
    (cd "$U" && xargs -0 -r -n "${WEBTOP_TEST_MOVE_BATCH:-1000}" sh -c 'mv -- "$@" "$0"' "$2")
}
[ ! -d "$T/upper" ] || move upper "$T/upper"
hook mid-moves
move junk "$T/junk"
log "moved $(grep -c . "$W/moves" || true) upper entries out"
hook after-moves

if [ -s "$W/inv" ]; then
  classify order | sort -n | cut -d' ' -f2 > "$W/inv.ordered"
  xargs -n 2000 "$NIXSTORE_BIN" --store "$UP" --delete --ignore-liveness < "$W/inv.ordered" >/dev/null
fi
log "invalidated"
hook after-delete

# Post-condition, from scratch. This, not GC's exit status, is the safety net: GC catches
# PathInUse and only prints "BUG" (gc.cc:687-690 in Nix 2.34).
nixstore --store "$UP" --dump-db > "$W/rows.reg"
list_upper
classify check > "$W/check"
if [ -s "$W/check" ]; then log "post-condition failed:"; cat "$W/check" >&2; exit 4; fi
hook after-check

# The overlay's workdir holds only transient state; start it empty (offline).
rm -rf "$N/work" && mkdir "$N/work"
write_lower_paths
[ -s "$W/inv" ] && echo invalidated > "$W/result" || echo clean > "$W/result" # for tests
rmdir "$T/junk" "$T" 2>/dev/null || true
rm -f "$N/partial.trash" "$N/partial.attempts" "$N/partial.nolinks" "$N/partial.created"
trap - EXIT
log "done"
