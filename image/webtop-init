#!@busybox@/bin/sh
# Container entrypoint (static busybox): per-user overlay /nix/store and /home on the volume, then
# exec systemd. Layout under /persist:
#   nix/upper, nix/work   overlay upper/work of /nix/store (lower: the image's store)
#   nix/var               /nix/var/nix of the overlay store (its DB holds the upper paths and the
#                         lower paths they reference)
#   nix/lower-stamp       stamp of the lower store the upper was built against
#   nix/reinstall/        after an image update: manifests, and the `pending` / `restore` markers
#   nix/trash-*/          the previous overlay, kept until webtop-nix-restore.service has copied the
#                         users' paths out of it (webtop-nix-trash.service deletes it)
#   home/user             the user's home, bind-mounted at each path in its .config/webtop/home-paths
#                         (ADR 0011); /home is a tmpfs holding only those
# WEBTOP_INIT_DEBUG=1       a failing step parks the container (shell / sleep) instead of exiting.
# WEBTOP_INIT_SKIP_OVERLAY=1 skips the store overlay (boots on the image's store alone).
export PATH=@busybox@/bin

STAMP_FILE=/webtop-image-stamp
# Account and group names of the image except the desktop user's, from its NixOS config.
RESERVED=@reservedNames@
P=/persist
N=$P/nix
H=$P/home/user

log() { echo "webtop-init: $*"; }

fail() {
  log "FAILED: $1"
  if [ "$WEBTOP_INIT_DEBUG" = 1 ]; then
    log "debug mode: parking; use kubectl exec"
    [ -t 0 ] && exec sh
    while :; do sleep 3600; done
  fi
  exit 1
}

# step <name> <command...>
step() {
  name=$1; shift
  log "step: $name"
  "$@" || fail "$name (exit $?)"
}

is_mounted() { awk -v m="$1" '$5 == m { f = 1 } END { exit !f }' /proc/self/mountinfo; }

mount_run() {
  # kubelet gives /run as a tmpfs; plain docker does not.
  is_mounted /run || mount -t tmpfs -o mode=755 tmpfs /run
}

make_rprivate() { mount --make-rprivate /; }

persist_path() {
  # The rest of the image (nix.conf, units) assumes /persist.
  src=${WEBTOP_PERSIST_PATH:-/persist}
  [ "$src" = /persist ] && return 0
  mkdir -p /persist && mount --bind "$src" /persist
}

bind_lower() {
  # Nix creates its state dirs even for a read-only lower store; they must exist before the ro bind.
  mkdir -p /nix/var/nix/profiles/per-user /nix/var/nix/gcroots/per-user /nix/var/nix/temproots /nix/var/nix/db &&
  mkdir -p /.lower/nix &&
  mount --bind /nix /.lower/nix &&
  # Source and target given: busybox otherwise looks the target up in /proc/mounts, whose lines
  # (one lowerdir per image layer) overflow its buffer.
  mount -o remount,bind,ro /nix /.lower/nix
}

# Store path name a profile symlink chain ends in. Resolved by hand: the target is usually an
# upper-only path, which does not exist before the overlay is mounted.
profile_target() {
  l=$1
  for _ in 1 2 3 4; do
    [ -L "$l" ] || break
    t=$(readlink "$l")
    case "$t" in
      /nix/store/*) echo "${t#/nix/store/}" | cut -d/ -f1; return 0 ;;
      /*) l=$t ;;
      *) l=$(dirname "$l")/$t ;;
    esac
  done
  return 1
}

# The overlay store forbids a changed lower store. When the image's store differs from the one the
# upper was built on: record each user's Nix profile manifest (fallback), move upper/work/var to
# trash-<epoch> and start on a fresh upper. webtop-nix-restore.service copies the users' paths back
# from the trash; webtop-nix-reinstall.service reinstalls what did not come back.
check_stamp() {
  new=$(cat "$STAMP_FILE") || return 1
  old=$(cat "$N/lower-stamp" 2>/dev/null)
  [ "$old" = "$new" ] && return 0
  if [ -z "$old" ] && [ ! -d "$N/upper" ]; then
    log "first boot on this volume"
    mkdir -p "$N" && echo "$new" > "$N/lower-stamp"
    return
  fi
  log "image store changed (${old:-no stamp} -> $new): starting a fresh store overlay"
  ts=$(date +%s)
  r=$N/reinstall
  mkdir -p "$r" || return 1
  for home in "$P"/home/*; do
    [ -d "$home/.local/state/nix/profiles" ] || continue
    u=$(basename "$home")
    if sp=$(profile_target "$home/.local/state/nix/profiles/profile"); then
      for d in "$N/upper" /.lower/nix/store; do
        if [ -f "$d/$sp/manifest.json" ]; then
          cp "$d/$sp/manifest.json" "$r/$u.manifest.json" && log "recorded the nix profile of $u ($sp)"
          break
        fi
      done
    fi
  done
  mkdir -p "$N/trash-$ts" || return 1
  for d in upper work var; do
    if [ -e "$N/$d" ]; then mv "$N/$d" "$N/trash-$ts/$d" || return 1; fi
  done
  # The users' profile links dangle until the restore; their GC roots come back at once so the
  # restored paths are never collectable.
  mkdir -p "$N/var" || return 1
  for d in gcroots profiles; do
    if [ -d "$N/trash-$ts/var/$d" ]; then cp -a "$N/trash-$ts/var/$d" "$N/var/$d" || return 1; fi
  done
  touch "$r/pending" "$r/restore"
  echo "$new" > "$N/lower-stamp"
}

prepare_persist() {
  # The upper DB is NOT seeded from the image: the overlay store reads lower paths from the lower
  # store's own DB (/.lower/nix/var/nix/db). This one holds the upper paths and the lower paths
  # they reference.
  mkdir -p "$N/upper" "$N/work" "$N/var" "$P/home"
}

mount_overlay() {
  mount -t overlay overlay \
    -o "lowerdir=/.lower/nix/store,upperdir=$N/upper,workdir=$N/work,userxattr" \
    /nix/store
}

bind_var() { mount --bind "$N/var" /nix/var/nix; }

# Login name rule (docs/contract.md, section 4), and not an account of the image: those are not in
# its passwd yet (activation writes it), hence the list. systemd-*: systemd's dynamic users.
login_name_ok() {
  [ ${#1} -le 40 ] || return 1
  case $1 in [a-z]*) ;; *) return 1 ;; esac
  case $1 in *[!a-z0-9-]* | systemd-*) return 1 ;; esac
  ! grep -qxF -- "$1" "$RESERVED"
}

# For log lines quoting the user's file.
printable() { printf '%s' "$1" | tr -d '\000-\037\177' | cut -c1-80; }

# The account (uid 1000) is renamed to WEBTOP_LOGIN_NAME at activation (image/nixos/identity.nix).
identity() {
  n=$WEBTOP_DESKTOP
  if ! login_name_ok "$n"; then
    log "desktop name '$(printable "$n")' is not a valid login name or is an account of the image: using 'user'"
    n=user
  fi
  # One passwd field, and a line of the env file: no separators, quotes or control characters.
  g=$(printf '%s' "$WEBTOP_DISPLAY_NAME" | tr -d '\000-\037\177:,"\\'"'")
  [ ${#g} -le 512 ] || g=
  export WEBTOP_LOGIN_NAME="$n" WEBTOP_LOGIN_GECOS="${g:-$n}"
}

# A directory in the home that root writes into: never through a symlink; created owned by the user.
user_dir() {
  if [ -L "$1" ] || { [ -e "$1" ] && [ ! -d "$1" ]; }; then
    log "ignoring the home paths file: $1 is not a directory"
    return 1
  fi
  [ -d "$1" ] || { mkdir "$1" && chown 1000:100 "$1"; }
}

# WEBTOP_HOME_PATHS: the current /home/<name> plus the valid lines of the user's home-paths file, at
# most 16. A volume from before (its data holds absolute /home/user paths) keeps /home/user whenever
# the file cannot be used. Writes to the file are best effort (a full volume must not stop the boot):
# it is created when missing, and the current path is appended when not listed.
home_paths() {
  cur=/home/$WEBTOP_LOGIN_NAME
  fallback=$cur
  if [ -d "$H" ]; then
    [ "$cur" = /home/user ] || fallback="$cur /home/user"
  else
    mkdir -p "$H" && chown 1000:100 "$H" && chmod 700 "$H" || return 1
  fi
  export WEBTOP_HOME_PATHS="$fallback"
  user_dir "$H/.config" && user_dir "$H/.config/webtop" || return 0
  f=$H/.config/webtop/home-paths
  if [ ! -e "$f" ] && [ ! -L "$f" ]; then
    if { echo "# Paths this home is mounted at. Your current one is added at every start and can't be removed."
         echo "# Delete an old one once nothing refers to it anymore; it disappears at the next start."
         for p in $fallback; do echo "$p"; done
       } > "$f.tmp" && chown 1000:100 "$f.tmp" && mv "$f.tmp" "$f"; then :; else
      log "could not create $f"
      rm -f "$f.tmp"
      return 0
    fi
  fi
  if [ -L "$f" ] || [ ! -f "$f" ]; then
    log "ignoring $f: not a regular file"
    return 0
  fi
  paths=$cur
  listed=
  lines=$(head -c 65536 "$f" | awk '{ sub(/#.*/, ""); gsub(/^[ \t\r]+|[ \t\r]+$/, ""); if ($0 != "") print }')
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    if [ "$p" = "$cur" ]; then listed=1; continue; fi
    case " $paths " in *" $p "*) continue ;; esac
    case $p in /home/*) n=${p#/home/} ;; *) n=/ ;; esac
    if ! login_name_ok "$n"; then
      log "home-paths: ignoring '$(printable "$p")': not /home/<login name>, or an account of the image"
    elif [ "$(echo "$paths" | wc -w)" -ge 16 ]; then
      log "home-paths: ignoring '$(printable "$p")': at most 16 paths"
    else
      paths="$paths $p"
    fi
  done <<EOF
$lines
EOF
  if [ -z "$listed" ]; then
    { [ -z "$(tail -c1 "$f")" ] || echo; echo "$cur"; } >> "$f" || log "could not add $cur to $f"
  fi
  WEBTOP_HOME_PATHS=$paths
}

mount_homes() {
  mount -t tmpfs -o mode=755,size=1m tmpfs /home || return 1
  for p in $WEBTOP_HOME_PATHS; do
    mkdir "$p" && mount --bind "$H" "$p" || return 1
  done
  log "home at: $WEBTOP_HOME_PATHS"
}

# systemd (PID 1) replaces stdout with /dev/null, so /proc/1/fd/1 is useless for logs. Relay a fifo
# (written by webtop-journal-relay.service) to our original stdout, which the runtime collects.
console_relay() {
  mkdir -p /run/webtop &&
  rm -f /run/webtop/console && mkfifo /run/webtop/console || return 1
  ( while :; do cat /run/webtop/console; done ) &
}

# logind offers sleep only if /sys/power/state is writable, which it is not in a pod. Sleep itself
# runs systemd-suspend.service, which the image maps to freezing the session, so a writable
# stand-in is enough.
fake_sys_power() {
  # Not `test -w`: busybox reports every file writable for root, even on a read-only mount.
  [ -e /sys/power/state ] && awk '$5 == "/sys" && $6 ~ /(^|,)ro(,|$)/ { f = 1 } END { exit !f }' /proc/self/mountinfo || return 0
  d=/run/webtop/sys-power
  mkdir -p $d && echo "freeze mem" > $d/state && echo "s2idle [deep]" > $d/mem_sleep &&
  mount --bind $d/state /sys/power/state &&
  { [ ! -e /sys/power/mem_sleep ] || mount --bind $d/mem_sleep /sys/power/mem_sleep; }
}

# systemd does not pass the container env to units; they read these files.
write_env() {
  mkdir -p /run/webtop &&
  { env | grep '^WEBTOP_'; [ -n "$WEBTOP_HTTP_PORT" ] || echo WEBTOP_HTTP_PORT=8080; } > /run/webtop/env.tmp &&
  mv /run/webtop/env.tmp /run/webtop/env &&
  echo "SELKIES_PORT=${WEBTOP_HTTP_PORT:-8080}" > /run/webtop/selkies.env
}

# Extra binary caches, !included by /etc/nix/nix.conf (container.nix). Newlines are folded so a
# value cannot add other settings.
write_nix_conf() {
  { [ -z "$WEBTOP_NIX_EXTRA_SUBSTITUTERS" ] ||
      echo "extra-substituters = $(echo "$WEBTOP_NIX_EXTRA_SUBSTITUTERS" | tr '\n' ' ')"
    [ -z "$WEBTOP_NIX_EXTRA_TRUSTED_PUBLIC_KEYS" ] ||
      echo "extra-trusted-public-keys = $(echo "$WEBTOP_NIX_EXTRA_TRUSTED_PUBLIC_KEYS" | tr '\n' ' ')"
  } > /run/webtop/nix.conf
}

step "mount /run" mount_run
step "make / rprivate" make_rprivate
step "volume at /persist" persist_path
if [ "$WEBTOP_INIT_SKIP_OVERLAY" = 1 ]; then
  log "WEBTOP_INIT_SKIP_OVERLAY=1: skipping the store overlay"
  step "prepare /persist" mkdir -p "$P/home"
else
  step "bind image /nix read-only at /.lower/nix" bind_lower
  step "lower store stamp" check_stamp
  step "prepare /persist" prepare_persist
  step "overlay on /nix/store" mount_overlay
  step "bind $N/var on /nix/var/nix" bind_var
fi
step "login name" identity
step "home paths" home_paths
step "bind $H at the home paths" mount_homes
step "console relay" console_relay
step "write /run/webtop/env" write_env
step "write /run/webtop/nix.conf" write_nix_conf
log "step: writable /sys/power stand-in"
fake_sys_power || log "no /sys/power stand-in: the desktop will not offer sleep"

log "exec /sbin/init"
exec /sbin/init
