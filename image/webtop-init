#!@busybox@/bin/sh
# Container entrypoint (static busybox): per-user store overlay (webtop-nix's webtop-store-init, layout
# in its README, "Store overlay") and /home on the volume, then exec systemd. Under /persist:
#   nix/                  the store overlay's state (webtop-nix)
#   home/user             the user's home, bind-mounted at each path in its .config/webtop/home-paths
#                         (ADR 0011); /home is a tmpfs holding only those
# WEBTOP_INIT_DEBUG=1       a failing step parks the container (shell / sleep) instead of exiting.
# WEBTOP_INIT_SKIP_OVERLAY=1 skips the store overlay (boots on the image's store alone).
export PATH=@busybox@/bin

# Account and group names of the image except the desktop user's, from its NixOS config.
RESERVED=@reservedNames@
P=/persist
H=$P/home/user

log() { echo "webtop-init: $*"; }

fail() {
  log "FAILED: $1"
  if [ "$WEBTOP_INIT_DEBUG" = 1 ]; then
    log "debug mode: parking; use kubectl exec"
    [ -t 0 ] && exec sh
    while :; do sleep 3600; done
  fi
  exit 1
}

# step <name> <command...>
step() {
  name=$1; shift
  log "step: $name"
  "$@" || fail "$name (exit $?)"
}

is_mounted() { awk -v m="$1" '$5 == m { f = 1 } END { exit !f }' /proc/self/mountinfo; }

mount_run() {
  # kubelet gives /run as a tmpfs; plain docker does not.
  is_mounted /run || mount -t tmpfs -o mode=755 tmpfs /run
}

make_rprivate() { mount --make-rprivate /; }

persist_path() {
  # The rest of the image (nix.conf, units) assumes /persist.
  src=${WEBTOP_PERSIST_PATH:-/persist}
  [ "$src" = /persist ] && return 0
  mkdir -p /persist && mount --bind "$src" /persist
}

# Login name rule (docs/contract.md, section 4), and not an account of the image: those are not in
# its passwd yet (activation writes it), hence the list. systemd-*: systemd's dynamic users.
login_name_ok() {
  [ ${#1} -le 40 ] || return 1
  case $1 in [a-z]*) ;; *) return 1 ;; esac
  case $1 in *[!a-z0-9-]* | systemd-*) return 1 ;; esac
  ! grep -qxF -- "$1" "$RESERVED"
}

# For log lines quoting the user's file.
printable() { printf '%s' "$1" | tr -d '\000-\037\177' | cut -c1-80; }

# The account (uid 1000) is renamed to WEBTOP_LOGIN_NAME at activation (image/nixos/identity.nix).
identity() {
  n=$WEBTOP_DESKTOP
  if ! login_name_ok "$n"; then
    log "desktop name '$(printable "$n")' is not a valid login name or is an account of the image: using 'user'"
    n=user
  fi
  # One passwd field, and a line of the env file: no separators, quotes or control characters.
  g=$(printf '%s' "$WEBTOP_DISPLAY_NAME" | tr -d '\000-\037\177:,"\\'"'")
  [ ${#g} -le 512 ] || g=
  export WEBTOP_LOGIN_NAME="$n" WEBTOP_LOGIN_GECOS="${g:-$n}"
}

# A directory in the home that root writes into: never through a symlink; created owned by the user.
user_dir() {
  if [ -L "$1" ] || { [ -e "$1" ] && [ ! -d "$1" ]; }; then
    log "ignoring the home paths file: $1 is not a directory"
    return 1
  fi
  [ -d "$1" ] || { mkdir "$1" && chown 1000:100 "$1"; }
}

# WEBTOP_HOME_PATHS: the current /home/<name> plus the valid lines of the user's home-paths file, at
# most 16. A volume from before (its data holds absolute /home/user paths) keeps /home/user whenever
# the file cannot be used. Writes to the file are best effort (a full volume must not stop the boot):
# it is created when missing, and the current path is appended when not listed.
home_paths() {
  cur=/home/$WEBTOP_LOGIN_NAME
  fallback=$cur
  if [ -d "$H" ]; then
    [ "$cur" = /home/user ] || fallback="$cur /home/user"
  else
    mkdir -p "$H" && chown 1000:100 "$H" && chmod 700 "$H" || return 1
  fi
  export WEBTOP_HOME_PATHS="$fallback"
  user_dir "$H/.config" && user_dir "$H/.config/webtop" || return 0
  f=$H/.config/webtop/home-paths
  if [ ! -e "$f" ] && [ ! -L "$f" ]; then
    if { echo "# Paths this home is mounted at. Your current one is added at every start and can't be removed."
         echo "# Delete an old one once nothing refers to it anymore; it disappears at the next start."
         for p in $fallback; do echo "$p"; done
       } > "$f.tmp" && chown 1000:100 "$f.tmp" && mv "$f.tmp" "$f"; then :; else
      log "could not create $f"
      rm -f "$f.tmp"
      return 0
    fi
  fi
  if [ -L "$f" ] || [ ! -f "$f" ]; then
    log "ignoring $f: not a regular file"
    return 0
  fi
  paths=$cur
  listed=
  lines=$(head -c 65536 "$f" | awk '{ sub(/#.*/, ""); gsub(/^[ \t\r]+|[ \t\r]+$/, ""); if ($0 != "") print }')
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    if [ "$p" = "$cur" ]; then listed=1; continue; fi
    case " $paths " in *" $p "*) continue ;; esac
    case $p in /home/*) n=${p#/home/} ;; *) n=/ ;; esac
    if ! login_name_ok "$n"; then
      log "home-paths: ignoring '$(printable "$p")': not /home/<login name>, or an account of the image"
    elif [ "$(echo "$paths" | wc -w)" -ge 16 ]; then
      log "home-paths: ignoring '$(printable "$p")': at most 16 paths"
    else
      paths="$paths $p"
    fi
  done <<EOF
$lines
EOF
  if [ -z "$listed" ]; then
    { [ -z "$(tail -c1 "$f")" ] || echo; echo "$cur"; } >> "$f" || log "could not add $cur to $f"
  fi
  WEBTOP_HOME_PATHS=$paths
}

mount_homes() {
  mount -t tmpfs -o mode=755,size=1m tmpfs /home || return 1
  for p in $WEBTOP_HOME_PATHS; do
    mkdir "$p" && mount --bind "$H" "$p" || return 1
  done
  log "home at: $WEBTOP_HOME_PATHS"
}

# systemd (PID 1) replaces stdout with /dev/null, so /proc/1/fd/1 is useless for logs. Relay a fifo
# (written by webtop-journal-relay.service) to our original stdout, which the runtime collects.
console_relay() {
  mkdir -p /run/webtop &&
  rm -f /run/webtop/console && mkfifo /run/webtop/console || return 1
  ( while :; do cat /run/webtop/console; done ) &
}

# systemd does not pass the container env to units; they read these files.
write_env() {
  mkdir -p /run/webtop &&
  { env | grep '^WEBTOP_' | grep -v '^WEBTOP_SELKIES_'; [ -n "$WEBTOP_HTTP_PORT" ] || echo WEBTOP_HTTP_PORT=8080; } > /run/webtop/env.tmp &&
  mv /run/webtop/env.tmp /run/webtop/env
}

# EnvironmentFile= of the Selkies unit (services.webtop.environmentFiles). WEBTOP_SELKIES_X=v in the
# pod env (docs/contract.md, "Selkies settings") becomes SELKIES_X="v". A value is written
# double-quoted with \ and " escaped, which systemd reads back literally (it does no $ expansion).
# The controller only sends single-line values; a line that is not one, or is too long, is skipped
# here too, so a stray newline cannot add settings. The port goes last and so wins.
write_selkies_env() {
  f=/run/webtop/selkies.env
  mkdir -p /run/webtop &&
  {
    env | grep '^WEBTOP_SELKIES_[A-Z0-9_]*=' | while IFS= read -r line; do
      k=${line%%=*}; k=${k#WEBTOP_}; v=${line#*=}
      if [ "$(printf %s "$v" | tr -d '\000-\037\177')" != "$v" ] || [ ${#v} -gt 1024 ]; then
        log "skipping $k: not a single line of at most 1024 bytes" >&2
        continue
      fi
      printf '%s="%s"\n' "$k" "$(printf %s "$v" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
    done
    echo "SELKIES_PORT=${WEBTOP_HTTP_PORT:-8080}"
  } > $f.tmp &&
  chmod 0644 $f.tmp && mv $f.tmp $f
}

# Extra binary caches, !included by /etc/nix/nix.conf (container.nix). Newlines are folded so a
# value cannot add other settings.
write_nix_conf() {
  { [ -z "$WEBTOP_NIX_EXTRA_SUBSTITUTERS" ] ||
      echo "extra-substituters = $(echo "$WEBTOP_NIX_EXTRA_SUBSTITUTERS" | tr '\n' ' ')"
    [ -z "$WEBTOP_NIX_EXTRA_TRUSTED_PUBLIC_KEYS" ] ||
      echo "extra-trusted-public-keys = $(echo "$WEBTOP_NIX_EXTRA_TRUSTED_PUBLIC_KEYS" | tr '\n' ' ')"
  } > /run/webtop/nix.conf
}

# The software center's default, for the session (docs/contract.md): only 0 or 1.
write_session_env() {
  mkdir -p /run/webtop &&
  case "$NSC_UNFREE_LISTED_DEFAULT" in
    0|1) echo "NSC_UNFREE_LISTED_DEFAULT=$NSC_UNFREE_LISTED_DEFAULT" ;;
  esac > /run/webtop/session.env.tmp &&
  mv /run/webtop/session.env.tmp /run/webtop/session.env
}

step "mount /run" mount_run
step "make / rprivate" make_rprivate
step "volume at /persist" persist_path
if [ "$WEBTOP_INIT_SKIP_OVERLAY" = 1 ]; then
  log "WEBTOP_INIT_SKIP_OVERLAY=1: skipping the store overlay"
else
  step "store overlay" @storeInit@/bin/webtop-store-init
fi
step "prepare $P/home" mkdir -p "$P/home"
step "login name" identity
step "home paths" home_paths
step "bind $H at the home paths" mount_homes
step "console relay" console_relay
step "write /run/webtop/env" write_env
step "write /run/webtop/selkies.env" write_selkies_env
step "write /run/webtop/nix.conf" write_nix_conf
step "write /run/webtop/session.env" write_session_env
log "step: writable /sys/power stand-in"
@sysPower@/bin/webtop-sys-power || log "no /sys/power stand-in: the desktop will not offer sleep"

# The system built from the admin's system.nix when it is current, else /sbin/init (webtop-nix README, "Admin defaults").
exec @defaultsBoot@/bin/webtop-defaults-boot
